  m_Name: SituacionApoyoDemo
  m_EditorClassIdentifier: LifeDrive::LifeDrive.Mapas.Demo.SituacionInterfazDemo
  titulo: Aviso de apoyo
  idDemo: demo.apoyo
  prefijoMapa: R3
  enunciado: "La central ensaya un aviso de emergencia en un punto cercano. \xBFC\xF3mo responder\xEDas en este ejercicio ficticio?"
  puntoDemostracion: 0.55
  respuestas:
  - texto: "Confirmar recepci\xF3n por el canal de apoyo"
    retroalimentacion: Has confirmado el aviso del ejercicio. Este reconocimiento no certifica una competencia real.
    consecuencia: 
    puntosSimulados: 10
    explicacionPuntos: +10 por atender el aviso ficticio.
    senalesSimuladas:
    - demo.aviso.emergencia
    hojaVisual: {fileID: 0}
  - texto: Omitir el aviso del ejercicio
    retroalimentacion: "La omisi\xF3n muestra una penalizaci\xF3n de prueba. No se ha comunicado ning\xFAn evento real."
    consecuencia: 
    puntosSimulados: -10
    explicacionPuntos: "\u221210 por omitir el aviso ficticio."
    senalesSimuladas: []
    hojaVisual: {fileID: 0}
