        "tipo": "PREGUNTA",
        "tema": "MANTENIMIENTO",
        "enunciado": "¿Qué debe hacerse antes de iniciar una operación de transporte?",
        "validada": false,
        "fecha_validacion": "",
        "alternativas": [
          {
            "id": 1,
            "descripcion": "Realizar la inspección preoperacional del vehículo",
            "es_acertada": true,
            "es_buena_practica": true,
            "puntos": 20,
            "retraso_min": 0,
            "explicacion": "La inspección preoperacional detecta fallas antes de salir y es una buena práctica obligatoria.",
            "tramo_destino_id": 0
          },
          {
            "id": 2,
            "descripcion": "Salir de inmediato para evitar retrasos",
            "es_acertada": false,
            "es_buena_practica": false,
            "puntos": 0,
            "retraso_min": 0,
            "explicacion": "Salir sin inspección expone a fallas de frenos, llantas o luces durante el recorrido.",
            "tramo_destino_id": 0
          },
          {
            "id": 3,
            "descripcion": "Revisar solo el combustible",
            "es_acertada": false,
            "es_buena_practica": false,
            "puntos": 0,
            "retraso_min": 0,
            "explicacion": "El combustible no basta: también se revisan frenos, llantas, luces y amarres de la carga.",
